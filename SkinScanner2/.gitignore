# =============================================
# Środowisko wirtualne Python (venv)
# =============================================
venv/
.venv/
env/
ENV/
.env/

# Ignorujemy tylko zawartość venv (bezpieczniej niż samo "Lib/")
**/venv/Lib/
**/venv/Scripts/
**/venv/Include/
**/venv/pyvenv.cfg
**/venv/share/

# Czasem venv ma też "lib" (na Linux/macOS) — ignorujemy tylko w venv
**/venv/lib/
**/venv/lib64/

# =============================================
# Standardowe rzeczy Python
# =============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.installed.cfg
*.egg
.eggs/
*.h5
*.pth
*.onnx

# =============================================
# Frontend (React / Next.js / Vite / shadcn)
# =============================================
node_modules/
dist/
build/
.next/
out/

# Nie ignorujemy folderu lib w src/frontend!
# (dlatego nie dajemy już samego "lib/")

# =============================================
# Dane projektu SkinScanner (prywatność + duże pliki)
# =============================================
history_images/
history.csv
shared_buffer/

models/*.h5
models/*.pth
models/*.onnx
models/*.pb

# =============================================
# Edytory, systemy, tmp
# =============================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Pliki środowiskowe
.env
.env.local
.env.development.local
.env.test.local
.env.production.local